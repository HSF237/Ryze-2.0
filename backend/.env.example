NODE_ENV=production
PORT=4000
API_DOMAIN=api.ryzestores.store
FRONTEND_ORIGIN=https://ryze-2-0.vercel.app
DATABASE_URL=postgresql://ryze:CHANGE_THIS_DATABASE_PASSWORD@postgres:5432/ryze
POSTGRES_DB=ryze
POSTGRES_USER=ryze
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
SESSION_COOKIE=ryze_session
SESSION_TTL_DAYS=30
TOKEN_PEPPER=CHANGE_TO_A_RANDOM_64_CHARACTER_SECRET
TRUST_PROXY=true
LOG_LEVEL=info
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
